{"step_index":123,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-01T14:11:11Z","input_tokens":2464,"cache_read_tokens":69368,"output_tokens":1560,"thinking":"The handler will process search queries, validating authorization before querying the database. The results will be formatted with inline buttons for each file match. A separate button will allow searching for torrents related to the query if no results are found initially.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"\"from hydrogram import Client, filters\\nfrom hydrogram.types import Message, CallbackQuery, InlineKeyboardMarkup, InlineKeyboardButton\\nimport config\\nfrom bot.utils.database import db\\nfrom bot.utils.torrent import search_torrents\\nfrom bot.handlers.start import is_authorized\\nfrom bot.handlers.indexer import format_size\\n\\n@Client.on_message(filters.text & filters.private & ~filters.command([\\\"start\\\", \\\"help\\\", \\\"index\\\"]))\\nasync def search_handler(client: Client, message: Message):\\n    \\\"\\\"\\\"\\n    Handles user movie searches. Queries MongoDB first; offers torrent fallback if not found.\\n    \\\"\\\"\\\"\\n    if not is_authorized(message.from_user.id):\\n        return\\n\\n    query = message.text.replace(\\\"/search\\\", \\\"\\\").strip()\\n    if len(query) < 2:\\n        await message.reply_text(\\\"ℹ️ Please enter at least 2 characters to search.\\\")\\n        return\\n\\n    status_msg = await message.reply_text(f\\\"🔍 Searching vault for `{query}`...\\\")\\n    results = await db.search_files(query, limit=10)\\n\\n    buttons = []\\n    if results:\\n        for item in results:\\n            title = item.get(\\\"file_name\\\", \\\"Unknown\\\")\\n            size_str = format_size(item.get(\\\"file_size\\\", 0))\\n            unique_id = item.get(\\\"unique_id\\\", item.get(\\\"file_id\\\"))\\n            btn_text = f\\\"📁 {title[:32]}... [{size_str}]\\\" if len(title) > 32 else f\\\"📁 {title} [{size_str}]\\\"\\n            buttons.append([InlineKeyboardButton(btn_text, callback_data=f\\\"get_{unique_id}\\\")])\\n\\n    # Always provide an option to search online torrents\\n    buttons.append([InlineKeyboardButton(\\\"⚡ Search Torrents Online\\\", callback_data=f\\\"tor_{query[:30]}\\\")])\\n\\n    if results:\\n        await status_msg.edit_text(\\n            f\\\"🎯 Found `{len(results)}` match(es) for **{query}** in your vault:\\\",\\n            reply_markup=InlineKeyboardMarkup(buttons)\\n        )\\n    else:\\n        await status_msg.edit_text(\\n            f\\\"❌ No files found for **{query}** in your Telegram vault.\\\\n\\\"\\n            \\\"Would you like to search onlin\n<truncated 2519 bytes>","Overwrite":"true","Path":"\"d:\\\\Direct_Link\\\\bot\\\\handlers\\\\search.py\""}}],"truncated_fields":["tool_calls"]}
