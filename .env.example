# Telegram API Credentials (from https://my.telegram.org)
API_ID=12345678
API_HASH=your_api_hash_here

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Private Channel ID for permanent media storage (e.g. -1001234567890)
LOG_CHANNEL_ID=-1001234567890

# MongoDB Atlas Connection URI (from https://www.mongodb.com/cloud/atlas)
MONGO_URI=your_mongodb_atlas_uri_here
DATABASE_NAME=stream_vault

# Whitelist Security: Comma-separated list of Telegram User IDs allowed to use the bot
ALLOWED_USERS=123456789,987654321

# Web Server Configuration for Direct Download / Streaming Links (DDL)
# For Hugging Face Spaces, PORT is 7860
PORT=7860
HOST=0.0.0.0
# Public base URL used to construct the streaming link in captions
# For Hugging Face Spaces: https://<username>-<spacename>.hf.space
# For local testing: http://localhost:7860
STREAM_URL=http://localhost:7860

# Optional: Comma-separated channel usernames to auto-index on startup
# e.g., @public_movie_channel_1, @public_movie_channel_2
CHANNELS_TO_INDEX=

# Cloud Torrent Leech Settings (GitHub Actions 1-Tap Trigger)
# Personal Access Token from https://github.com/settings/tokens (with 'repo' scope)
GH_TOKEN=
GITHUB_REPO=Aswin-2266/stream-vault
